# Server-only. Never prefix with NEXT_PUBLIC_.

# Public origin used in links (llms.txt, MCP results, API urls).
SESSIONS_ORIGIN=https://sessions.dataimago.ai

# Ask the corpus (Claude Sonnet 5.5) and query embeddings (OpenAI).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# SESSIONS_MODEL_ASK=claude-sonnet-5-5
# SESSIONS_MODEL_EMBEDDING=text-embedding-3-large

# Daily spend cap for Ask, in USD (resets 00:00 UTC). Prices per million tokens.
SESSIONS_ASK_DAILY_CAP_USD=3
# SESSIONS_ASK_PRICE_INPUT=3
# SESSIONS_ASK_PRICE_OUTPUT=15

# Upstash Redis via the Vercel Marketplace (set automatically when connected).
# Required in production for Ask: without it Ask refuses rather than run uncapped.
KV_REST_API_URL=
KV_REST_API_TOKEN=
